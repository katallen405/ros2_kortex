kortex_effort_controller:
  ros__parameters:
    type: kortex_effort_controller/KortexEffortController
    joints:
      - joint_1
      - joint_2
      - joint_3
      - joint_4
      - joint_5
      - joint_6
      - joint_7
    # Conservative torque limits (Nm): joints 1-4 large actuators, 5-7 small
    torque_limits: [39.0, 39.0, 39.0, 39.0, 9.0, 9.0, 9.0]
    command_topic: ~/joint_torque_command
